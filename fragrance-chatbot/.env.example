# Single key (fallback, used if GEMINI_API_KEYS is not set)
GEMINI_API_KEY=your-gemini-api-key-here

# Preferred: comma-separated keys from separate Google Cloud projects.
# Google's free-tier quota is per-project, so keys from the SAME project
# do not add up — create each key with "Create API key in new project".
# GEMINI_API_KEYS=key-from-project-1,key-from-project-2,key-from-project-3,key-from-project-4

GEMINI_MODEL=gemini-3.5-flash-lite
