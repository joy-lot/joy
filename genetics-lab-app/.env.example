# 이 파일을 복사할 필요는 없습니다 — Vercel 프로젝트의 "Environment Variables" 설정 화면에
# 아래 이름 그대로 값을 입력하세요. (.env 파일은 절대 커밋하지 마세요.)

# Gemini API 키. 키가 하나뿐이면 GEMINI_API_KEY만 채우세요.
GEMINI_API_KEY=

# 키가 여러 개면(무료 한도를 나눠 쓰고 싶을 때) 이 변수 하나에 쉼표로 이어붙이세요.
# 이 값이 있으면 GEMINI_API_KEY보다 우선 사용되고, 요청마다 돌아가며 쓰다가
# 특정 키가 한도(429)에 걸리면 자동으로 다음 키로 재시도합니다.
# 예: GEMINI_API_KEYS=AIzaSy111...,AIzaSy222...,AIzaSy333...
GEMINI_API_KEYS=

# 선택: 사용할 Gemini 모델. 비워두면 gemini-3.5-flash-lite 사용
GEMINI_MODEL=

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 교사 대시보드 접속용 암호(원하는 문자열로 직접 정하세요)
TEACHER_PASSCODE=
