# 이 파일을 복사할 필요는 없습니다 — Vercel 프로젝트의 "Environment Variables" 설정 화면에
# 아래 이름 그대로 값을 입력하세요. (.env 파일은 절대 커밋하지 마세요.)

# Google AI Studio(aistudio.google.com)에서 발급받은 Gemini API 키
GEMINI_API_KEY=

# 선택: 사용할 Gemini 모델. 비워두면 gemini-2.5-flash 사용
GEMINI_MODEL=

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 교사 대시보드 접속용 암호(원하는 문자열로 직접 정하세요)
TEACHER_PASSCODE=
